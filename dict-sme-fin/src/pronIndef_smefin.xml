  <e>
    <lg>
      <l pos="Pron" type="Indef">buohkat</l>
    </lg>
    <mg>
      <tg xml:lang="fin">
        <re>ihmisistä</re>
        <t pos="Pron">kaikki</t>
        <xg>
          <x>Čoahkkin lea rabas buohkaide – bures boahtin!</x>
          <xt>_FIN_</xt>
        </xg>
      </tg>
    </mg>
  </e>
  <e>
    <lg>
      <l pos="Pron" type="Indef">buot</l>
    </lg>
    <mg>
      <tg xml:lang="fin">
        <t pos="Pron">kaikki</t>
        <xg>
          <x src="SIKOR">Ipmilii buot lea vejolaš.</x>
          <xt>_FIN_</xt>
        </xg>
        <xg>
          <x>Buot oahpahus lea sámegillii.</x>
          <xt>_FIN_</xt>
        </xg>
        <xg>
          <x src="SIKOR">Álggus lea minikonsearta buot mánáide gaskal 0 ja 10 jagi.</x>
          <xt>_FIN_</xt>
        </xg>
      </tg>
    </mg>
  </e>
  <e>
    <lg>
      <l pos="Pron" type="Indef">eará</l>
    </lg>
    <mg>
      <tg xml:lang="fin">
        <t pos="Pron">muu</t>
        <t pos="Pron">eri</t>
        <t pos="Pron">muuta</t>
        <xg>
          <x>Dákkár viiddis máhttu ii leat nu gallásis earáin.</x>
          <xt>_FIN_</xt>
        </xg>
      </tg>
    </mg>
  </e>
  <e>
    <lg>
      <l pos="Pron" type="Indef">goabbat</l>
    </lg>
    <mg>
      <tg xml:lang="fin">
        <t pos="Pron">kumpikin</t>
        <xg>
          <x>Sii doalahit dálá organiserema mas lea okta rektor goabbatge skuvllas.</x>
          <xt>_FIN_</xt>
        </xg>
        <xg>
          <x>Dán áššis orrot hálddahus ja stivra goabbat oaivilis.</x>
          <xt>_FIN_</xt>
        </xg>
        <xg>
          <x>De leigga oastán goabbat bohttala cola.</x>
          <xt>_FIN_</xt>
        </xg>
        <xg>
          <x>Moai čohkkájetne soffás goabbat telefovnnain.</x>
          <xt>_FIN_</xt>
        </xg>
      </tg>
    </mg>
  </e>
  <e>
    <lg>
      <l pos="Pron" type="Indef">guktot</l>
    </lg>
    <mg>
      <tg xml:lang="fin">
        <t pos="Pron">molemmat</t>
        <xg>
          <x>Moai letne guktot fitnan Helssegis.</x>
          <xt>_FIN_</xt>
        </xg>
      </tg>
    </mg>
  </e>
  <e>
