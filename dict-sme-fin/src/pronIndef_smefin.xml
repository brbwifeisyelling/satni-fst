        <xg>
          <x>Muhto soapmásiin ledje áibbas eará beroštumit.</x>
          <xt>_FIN_</xt>
        </xg>
        <xg>
          <x>Lei buorre dálki ja soames guolli nai.</x>
          <xt>_FIN_</xt>
        </xg>
      </tg>
    </mg>
  </e>
  <e>
    <lg>
      <l pos="Pron" type="Indef">goappašat</l>
    </lg>
