        <t pos="Pron" type="Indef">molemmat</t>
        <xg>
          <x>Goappašat dievddut dárbbašeigga doavtterdivššu.</x>
          <xt>_FIN_</xt>
        </xg>
        <xg>
          <x>Iskkadeapmi galgá čuvget goappašiid beliid.</x>
          <xt>_FIN_</xt>
        </xg>
      </tg>
    </mg>
  </e>
  <e>
    <lg>
      <l pos="Pron" type="Indef">iešguhtet</l>
    </lg>
    <mg>
      <tg xml:lang="fin">
        <t pos="Pron" type="Indef">jokainen</t>
