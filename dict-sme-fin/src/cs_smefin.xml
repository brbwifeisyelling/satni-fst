  <e>
    <lg>
      <l pos="CS">ahte</l>
    </lg>
    <mg>
      <tg xml:lang="fin">
        <t pos="CS">että</t>
        <xg>
          <x>Lea hui mávssolaš ahte sin dárbbut váldojit vuhtii.</x>
          <xt>_FIN_</xt>
        </xg>
        <xg>
          <x>Heaika lei bávččagahttán čippi, nu ahte skierpmui máŋga beaivve.</x>
          <xt>_FIN_</xt>
        </xg>
      </tg>
    </mg>
  </e>
