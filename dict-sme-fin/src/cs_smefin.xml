  <e>
    <lg>
      <l pos="CS">nugo</l>
    </lg>
    <mg>
      <tg xml:lang="fin">
        <t t_type="phrase">niin kuin</t>
        <t pos="CS">kuten</t>
        <xg>
          <x>Daga nugo mun.</x>
          <xt>_FIN_</xt>
        </xg>
        <xg>
          <x>Nugo?</x>
          <xt>_FIN_</xt>
        </xg>
        <xg>
          <x>Dán áigásaš ođasmuitaleaddjit eai máhte ságaidge muitalit nugo dolin lávejedje.</x>
          <xt>_FIN_</xt>
        </xg>
        <xg>
          <x>Jieŋa alde ledje maid smávva suohtastallamat, nugo gámabálkesteapmi.</x>
          <xt>_FIN_</xt>
        </xg>
      </tg>
    </mg>
  </e>
