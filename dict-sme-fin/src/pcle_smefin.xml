  <e>
    <lg>
      <l pos="Pcle">aitto</l>
    </lg>
    <mg>
      <tg xml:lang="fin">
        <t pos="Pcle">-pa</t>
        <t pos="Pcle">-pä</t>
        <t pos="Pcle">-han</t>
        <t pos="Pcle">-hän</t>
        <xg>
          <x>Mo dal aitto geavvá?</x>
          <xt>_FIN_</xt>
        </xg>
        <xg>
          <x>Lean aitto doaibmagoahtán hárjeheaddjin, ja in leat vuos nu čeahppi.</x>
          <xt>_FIN_</xt>
        </xg>
      </tg>
    </mg>
